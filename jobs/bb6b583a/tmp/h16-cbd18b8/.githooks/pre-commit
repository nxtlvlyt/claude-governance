#!/bin/sh
# Deterministic source gate for the muezzin-plugin repo (#43).
#
# WHY: this repo's commits are hand/Opus-authored governance-critical source. They must be witnessed before
# they land — the plugin's own deeds-not-claims thesis demands it. But the GLOBAL laguna pre-commit hook
# (a 33B Ollama review with a ~36h timeout) cannot be that witness here: it would stall the plugin's frequent
# build-commits and collide with the cloud seats' own Ollama use. So this gate is DETERMINISTIC and OLLAMA-FREE
# — it cannot hang. It turns "I tested it" into a captured exit code:
#   - every staged .mjs is syntax-checked with `node --check` (the cheap mechanical witness);
#   - every staged OFFLINE module also runs its argv-guarded self-test (`node <module>.mjs`) as a real receipt.
# Live-dispatch modules (cloud/Ollama/network) are syntax-checked only — their self-tests need the cloud key
# and a live backend, which a pre-commit must not depend on. Scratch files (_*.mjs) are syntax-checked only.
#
# Bypass (rare, explicit): git commit --no-verify
set -e
staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.mjs')
[ -z "$staged" ] && exit 0

# Modules whose self-test dispatches to cloud/Ollama or the network — syntax-check only, never run in-hook.
# run-mission.mjs / orchestrate-cli.mjs are LAUNCHERS: bare invocation is a usage error (exit 2) by design,
# and any real invocation dispatches live seats — exactly what a pre-commit must never do.
NETWORK="deconstructor.mjs executor.mjs repair.mjs seat_dispatch.mjs run-mission.mjs orchestrate-cli.mjs"
fail=0

for f in $staged; do
  [ -f "$f" ] || continue
  if ! node --check "$f" 2>&1; then
    echo "[muezzin-gate] SYNTAX FAIL: $f" >&2
    fail=1
    continue
  fi
  base=$(basename "$f")
  case "$base" in
    _*) echo "[muezzin-gate] $f — syntax OK (scratch, no self-test)"; continue;;
  esac
  # DAEMON: bare invocation starts the MAIN LOOP — committing daemon code from inside
  # this hook literally spawned extra daemons (triple-daemon race, 2026-06-09). Its
  # self-test runs ONLY via the flag.
  case "$base" in
    muezzin-daemon.mjs)
      if node "$f" --selftest >/dev/null 2>&1; then
        echo "[muezzin-gate] $f — syntax OK + --selftest PASS"
      else
        echo "[muezzin-gate] SELF-TEST FAIL: $f  (run 'node $f --selftest')" >&2; fail=1
      fi
      continue;;
  esac
  case " $NETWORK " in
    *" $base "*) echo "[muezzin-gate] $f — syntax OK (self-test skipped: network/cloud seat)"; continue;;
  esac
  # Offline module: run its self-test as a real receipt. A module that fails its OWN self-test must not commit.
  if node "$f" >/dev/null 2>&1; then
    echo "[muezzin-gate] $f — syntax OK + self-test PASS"
  else
    echo "[muezzin-gate] SELF-TEST FAIL: $f  (run 'node $f' to see it)" >&2
    fail=1
  fi
done

if [ "$fail" != 0 ]; then
  echo "[muezzin-gate] BLOCKED — fix the above, or bypass explicitly with: git commit --no-verify" >&2
  exit 1
fi
echo "[muezzin-gate] PASS — staged .mjs syntax + offline self-tests green"
exit 0
