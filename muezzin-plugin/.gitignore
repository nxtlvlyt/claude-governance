
# ============================================================================
# DAEMON RUNTIME CONTAINMENT (2026-06-15, engine-reliability-1)
# The muezzin daemon writes its runtime state INTO its own repo, which made the
# plugin repo perpetually dirty and broke clean self-edits (containment-drift,
# every engine edit). These are RUNTIME (regenerated by the daemon), never source.
# Authored source that STAYS tracked: *.mjs, docs/*.md, missions/*.mission.txt.
# ============================================================================

# mission SANDBOXES are their own git repos (per-step commits) — never tracked here
missions/*/

# the daemon's per-run RECEIPTS (mission output, regenerated each run)
missions/*.result.json

# daemon-RENDERED top-level boards (rewritten every beat — not authored)
missions/AUTORUN.md
missions/MISSION-STATUS.md

# the ENTIRE _logs tree is daemon runtime: ledgers, queues, seat-record, retros,
# daemon stdout/stderr, the status board, heartbeats, event streams. None is source.
missions/_logs/

# local untracked files and folders
_checkpoint.json
_prior-attempt/
*.raw.txt
mission-events.jsonl

# wrangler's local build/deploy cache (regenerated per-machine, not source)
.wrangler/
.brave-key
searxng-settings.local.yml
*.local.yml
